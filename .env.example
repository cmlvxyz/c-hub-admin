# ── C-HUB ADMIN (c-hub-admin) ─────────────────────────────────────────
# Shared Turso database (the SAME credentials are used by c-hub-store).
DATABASE_URL=libsql://c-hub-aegix2025.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=

# Default admin account, auto-created on first boot (seeding is idempotent).
ADMIN_EMAIL=admin@chubph.com
ADMIN_PASSWORD=ChangeMe1234!
ADMIN_AUTO_LOGIN=true

# Comma-separated list of allowed CORS origins (the deployed Vercel URLs are
# always allowed). Example:
# CORS_ORIGIN=https://your-store.vercel.app,https://your-admin.vercel.app

# Optional: point the frontend at a specific API base during local dev.
# Leave unset to use the same origin ("").
# VITE_API_URL=http://localhost:3007

# Local backend port (not used by Vercel).
PORT=3007